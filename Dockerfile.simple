FROM eclipse-temurin:25-jre
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY ani-rss.jar /app/ani-rss.jar
ENV CONFIG=/config TZ=Asia/Shanghai
VOLUME ["/config", "/resources", "/playback"]
EXPOSE 7789
ENTRYPOINT ["java", "-Dfile.encoding=UTF-8", "-Xmx512m", "-jar", "/app/ani-rss.jar"]
